# DESTRUCTIVE FOUNDATION INTEGRATION TEST DATABASE ONLY.
# The database name must clearly contain foundation_test, integration_test,
# erp_test, or test_erp. Never point this at construction_erp.
TEST_DATABASE_URL=postgresql://construction_erp:construction_erp@localhost:5432/construction_erp_foundation_test?schema=public
TEST_DATABASE_CONFIRM=RESET_CONSTRUCTION_ERP_TEST_DATABASE
RUN_FOUNDATION_DB_TESTS=1

# Pass 36 browser workflow. This extra opt-in prevents accidental destructive E2E runs.
RUN_MODULE_24A_E2E=1
RUN_MODULE_24A_AUDIT_GUARD=1
MODULE_24A_LIVE_GATE_CONFIRM=RUN_CONSTRUCTION_ERP_MODULE_24A_LIVE_GATE

# Server-only HMAC secret for invitation/password-reset action links.
AUTH_ACTION_TOKEN_SECRET=test-only-auth-action-secret-0123456789abcdef
AUTH_ACTION_PUBLIC_URL=http://localhost:5173
# Configure these only when running the real notification worker in an integration environment.
AUTH_NOTIFICATION_WEBHOOK_URL=http://localhost:4000/auth-notifications
AUTH_NOTIFICATION_WEBHOOK_TOKEN=test-auth-notification-webhook-token

# Module 18 Pass 62 browser/live acceptance.
# Keep Module 24A E2E disabled because Playwright runs one module workflow at a time.
RUN_MODULE_18_E2E=1
MODULE_18_LIVE_GATE_CONFIRM=RUN_CONSTRUCTION_ERP_MODULE_18_LIVE_GATE


# Pass 87 real S3-compatible signed upload/download acceptance.
# Use a dedicated disposable bucket whose name clearly contains test/integration/acceptance.
RUN_MODULE_18_S3_TESTS=1
MODULE_18_STORAGE_CONFIRM=USE_CONSTRUCTION_ERP_MODULE_18_TEST_STORAGE
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=construction-erp-module-18-test
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_MAX_SIGNED_URL_TTL_SECONDS=300
