# API/server configuration
# Copy this file to apps/api/.env only if your process manager/dev tooling loads it.
# Never commit real secrets.

NODE_ENV=development
APP_NAME=Construction ERP
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
API_PUBLIC_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:5173
SHUTDOWN_GRACE_MS=10000

# Server-only PostgreSQL connection. Never expose this through VITE_* variables.
DATABASE_URL=postgresql://construction_erp:construction_erp@localhost:5432/construction_erp?schema=public


# S3-compatible private object storage.
# Example values target a local MinIO-compatible endpoint; replace them in real environments.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=construction-erp
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_MAX_SIGNED_URL_TTL_SECONDS=300

# Operations and observability.
# Health/readiness are always registered. Aggregate metrics/queue/outbox routes
# default to true in development/test and false in production.
OPERATIONS_DIAGNOSTICS_ENABLED=true
OPERATIONS_READINESS_TIMEOUT_MS=2000
OPERATIONS_STALE_LEASE_SECONDS=300

# Administration asynchronous invitation/password-reset delivery.
# The worker creates signed links only when it delivers a queued notification.
AUTH_ACTION_TOKEN_SECRET=development-only-auth-action-secret-change-me
AUTH_ACTION_PUBLIC_URL=http://localhost:5173
AUTH_NOTIFICATION_WEBHOOK_URL=http://localhost:4000/auth-notifications
AUTH_NOTIFICATION_WEBHOOK_TOKEN=development-webhook-token
