{
  "name": "@construction-erp/api",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "worker:auth-notifications": "tsx src/workers/auth-notification.worker.ts",
    "start:auth-notifications": "node dist/workers/auth-notification.worker.js",
    "worker:report-exports": "tsx src/workers/report-export.worker.ts",
    "start:report-exports": "node dist/workers/report-export.worker.js"
  },
  "dependencies": {
    "@construction-erp/audit": "workspace:*",
    "@construction-erp/config": "workspace:*",
    "@construction-erp/contracts": "workspace:*",
    "@construction-erp/database": "workspace:*",
    "@construction-erp/errors": "workspace:*",
    "@construction-erp/idempotency": "workspace:*",
    "@construction-erp/logging": "workspace:*",
    "@construction-erp/numbering": "workspace:*",
    "@construction-erp/operations": "workspace:*",
    "@construction-erp/outbox": "workspace:*",
    "@construction-erp/queue": "workspace:*",
    "@construction-erp/request-context": "workspace:*",
    "@construction-erp/shared": "workspace:*",
    "@construction-erp/storage": "workspace:*",
    "@construction-erp/tenant-scope": "workspace:*",
    "fastify": "^5.0.0",
    "zod": "^3.24.0",
    "@construction-erp/bootstrap": "workspace:*",
    "@fastify/swagger": "^9.0.0",
    "@fastify/cors": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0"
  }
}
