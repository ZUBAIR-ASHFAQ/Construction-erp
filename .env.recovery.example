# Foundation Pass 20 — recovery tooling. Never commit real credentials.
# Backups are written below this directory with mode-restricted files.
RECOVERY_BACKUP_DIR=./backups
RECOVERY_BACKUP_ID=

# Source PostgreSQL is the normal server DATABASE_URL.
DATABASE_URL=postgresql://construction_erp:construction_erp@localhost:5432/construction_erp?schema=public

# Restore target MUST be a disposable recovery/drill database unless an approved
# production recovery explicitly sets RECOVERY_ALLOW_PRODUCTION_RESTORE=1.
RESTORE_DATABASE_URL=postgresql://construction_erp:construction_erp@localhost:5432/construction_erp_recovery_drill?schema=public
RESTORE_CONFIRM=RESTORE_CONSTRUCTION_ERP_DATA
RECOVERY_ALLOW_PRODUCTION_RESTORE=0

# Source object store uses STORAGE_*.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=construction-erp
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin

# Restore/drill bucket. Use a separate bucket for routine drills.
RESTORE_STORAGE_ENDPOINT=http://localhost:9000
RESTORE_STORAGE_REGION=us-east-1
RESTORE_STORAGE_BUCKET=construction-erp-recovery-drill
RESTORE_STORAGE_FORCE_PATH_STYLE=true
RESTORE_STORAGE_ACCESS_KEY_ID=minioadmin
RESTORE_STORAGE_SECRET_ACCESS_KEY=minioadmin
RECOVERY_ALLOW_SOURCE_BUCKET_RESTORE=0
RECOVERY_ALLOW_OBJECT_OVERWRITE=0

# Full destructive drill requires an additional explicit confirmation.
RECOVERY_DRILL_CONFIRM=RUN_CONSTRUCTION_ERP_RECOVERY_DRILL
RECOVERY_POSTGRES_BACKUP_DIR=./backups/<backup-id>/postgres
RECOVERY_STORAGE_BACKUP_DIR=./backups/<backup-id>/object-storage

# Pass 83 note:
# `pnpm foundation:acceptance:live` creates a fresh shared RECOVERY_BACKUP_ID and derives
# RECOVERY_POSTGRES_BACKUP_DIR / RECOVERY_STORAGE_BACKUP_DIR automatically.
# Set those two directories manually only when running `pnpm recovery:drill`
# against an already-created backup.
